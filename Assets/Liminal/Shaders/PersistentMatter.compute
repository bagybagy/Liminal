#pragma kernel Initialize
#pragma kernel Simulate
#include "MatterFlow.hlsl"
#include "WhaleAnatomy.hlsl"

static const int WhaleRingCount = 12;
static const int WhaleTargetsPerRing = 4;

struct MatterSeed
{
    float4 form;
    float4 destination;
    float4 color;
    float4 traits;
};

struct MatterGroup
{
    float4x4 localToWorld;
    float4 state;
    float4 impulse;
};

struct MatterParticle
{
    float4 positionAge;
    float4 velocityEnergy;
    float4 colorSize;
    float4 identityState;
};

StructuredBuffer<MatterSeed> _Seeds;
StructuredBuffer<MatterGroup> _Groups;
StructuredBuffer<float4> _WhalePatches;
StructuredBuffer<float4> _AlternateForms;
StructuredBuffer<float4x4> _BirthMatrices;
StructuredBuffer<float4> _GroupVelocities;
RWStructuredBuffer<MatterParticle> _Particles;
uint _Count;
int _WhaleGroup;
float _Delta, _Song, _CurrentEnergy;
float4 _Current;
float3 _CurrentVelocity, _Player, _PlayerVelocity;
float3 _WhaleVelocity;
float _WhaleSurfaceActivity, _WhaleTurn, _WhaleArrival;
float3 _ArrivalOrigin;
float _WhaleFormation;

float Hash(float n)
{
    return frac(sin(n * 127.1 + 311.7) * 43758.5453);
}

float3 Curl(float3 p, float t)
{
    return float3(cos(p.y * 0.63 + t) * 0.63 + sin(p.z * 0.77 - t * 0.6) * 0.77,
        cos(p.z * 0.51 + t * 0.7) * 0.51 + sin(p.x * 0.67 + t * 0.8) * 0.67,
        cos(p.x * 0.59 - t * 0.9) * 0.59 + sin(p.y * 0.71 - t) * 0.71);
}

float3 Deform(float3 p, float3 localForm, float seed, float kind, float tail, float song)
{
    if (kind > 0.5 && kind < 1.5)
    {
        if (localForm.y < 0.0)
        {
            float u = saturate(-localForm.y / 24.0);
            p.x += sin(song * 1.3 + seed * 2.7 + u * 5.0) * u * 0.72;
            p.z += cos(song * 1.1 + seed * 2.1 + u * 4.0) * u * 0.72;
        }
        p.y += saturate((localForm.y + 0.4) * 0.8) * sin(song * 2.0 + seed * 3.0) * 0.10;
    }
    else if (kind > 1.5 && kind < 2.5)
    {
        p.y += sin(song * 8.0 + seed * 3.0) * tail * 0.16;
        p.x += sin(song * 4.5 + seed * 2.0) * tail * 0.10;
    }
    else if (kind > 2.5)
    {
        p = WhaleDeform(localForm, song);
    }
    return p;
}

float3 DolphinDeform(float3 p, float song)
{
    float tail = saturate((-p.z - 2.0) / 7.5);
    p.y += sin(song * 2.2 + p.z * 0.22) * tail * 0.82;
    p.x += sin(song * 1.1 + p.z * 0.18) * tail * 0.22;

    float finSpan = saturate((abs(p.x) - 0.75) / 3.75);
    float finRoot = saturate((p.z + 2.5) / 2.5) * saturate((4.8 - p.z) / 2.0);
    float fin = finSpan * finRoot;
    float finPhase = song * 1.35 + p.z * 0.12;
    p.y += sin(finPhase) * fin * 0.36;
    p.z += cos(finPhase) * fin * 0.10;
    return p;
}

float3 FormTarget(MatterSeed seed, MatterGroup group, float song, uint id)
{
    if (seed.traits.y > 3.5 && _GroupVelocities[(uint)round(seed.traits.x)].w > 0.5)
        return mul(group.localToWorld, float4(DolphinDeform(_AlternateForms[id].xyz, song), 1)).xyz;
    float animationPhase = seed.traits.y > 1.5 && seed.traits.y < 2.5 ? seed.traits.x : seed.traits.z;
    float3 local = Deform(seed.form.xyz, seed.form.xyz, animationPhase, seed.traits.y, seed.traits.w, song);
    float3 target = mul(group.localToWorld, float4(local, 1.0)).xyz;
    if (seed.traits.y > 2.5 && _WhaleFormation < 0.9999)
    {
        // The whale's own IDs spiral out of the gyre, rather than fading in an existing silhouette.
        float lane = Hash(id + 19.0);
        float angle = lane * 6.2831853 + song * 1.6 + seed.form.z * 0.028;
        float radius = 30.0 + Hash(id + 37.0) * 60.0;
        float height = -75.0 + Hash(id + 71.0) * 55.0;
        float3 source = _ArrivalOrigin + float3(cos(angle) * radius, height, sin(angle) * radius);
        float gather = smoothstep(lane * 0.18, 0.80 + lane * 0.20, _WhaleFormation);
        target = lerp(source, target, gather);
    }
    return target;
}

float WhalePatchHeat(float3 position, float localZ)
{
    int centerRing = (int)round(saturate((localZ + 68.0) / 136.0) * (WhaleRingCount - 1));
    float heat = 0.0;
    [unroll]
    for (int ringOffset = -1; ringOffset <= 1; ringOffset++)
    {
        int ring = clamp(centerRing + ringOffset, 0, WhaleRingCount - 1);
        [unroll]
        for (int quadrant = 0; quadrant < WhaleTargetsPerRing; quadrant++)
        {
            float4 patch = _WhalePatches[ring * WhaleTargetsPerRing + quadrant];
            float3 offset = position - patch.xyz;
            heat = max(heat, patch.w * exp(-dot(offset, offset) * 0.03));
        }
    }
    return heat;
}

[numthreads(128, 1, 1)]
void Initialize(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Count) return;
    MatterSeed seed = _Seeds[id.x];
    MatterGroup group = _Groups[(uint)round(seed.traits.x)];
    MatterParticle p;
    p.positionAge = float4(FormTarget(seed, group, _Song, id.x), 0.0);
    p.velocityEnergy = float4(0, 0, 0, group.state.z);
    p.colorSize = float4(seed.color.rgb, max(0.001, seed.form.w));
    float patchHeat = seed.traits.y > 2.5
        ? WhalePatchHeat(p.positionAge.xyz, seed.form.z) : 0.0;
    p.identityState = float4(id.x, round(seed.traits.x), group.state.x, patchHeat);
    _Particles[id.x] = p;
}

[numthreads(128, 1, 1)]
void Simulate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Count) return;
    MatterSeed seed = _Seeds[id.x];
    MatterParticle p = _Particles[id.x];
    MatterGroup group = _Groups[(uint)p.identityState.y];
    float phase = group.state.x;
    float age = max(0.0, group.state.y);
    float energy = max(0.0, group.state.z);
    float kind = seed.traits.y;
    float3 position = p.positionAge.xyz;
    float3 velocity = p.velocityEnergy.xyz;
    float4 dolphinVelocity = _GroupVelocities[(uint)p.identityState.y];
    bool isDolphin = kind > 3.5 && dolphinVelocity.w > 0.5;
    bool isWhale = kind > 2.5 && !isDolphin;
    float3 target = FormTarget(seed, group, _Song, id.x);
    float3 acceleration = 0;

    if (phase > 4.5)
    {
        float converge = smoothstep(0.0, 3.0, age);
        float stiffness = lerp(3.0, 100.0, converge);
        float3 offset = target - position;
        float3 axis = normalize(offset + float3(0.001,0.002,0.003));
        float3 swirl = cross(axis, Curl(position * 0.035, _Song * 0.6 + seed.traits.z));
        acceleration = offset * stiffness - (velocity - _WhaleVelocity) * (2.0 * sqrt(stiffness));
        acceleration += swirl * 16.0 * (1.0 - converge);
        acceleration += MatterCurrent(position,age,seed.traits.z)*6.0*(1.0-converge);
    }
    else if (phase > 3.5)
    {
        float morph = smoothstep(0.2, 1.65, age);
        float3 source = mul(_BirthMatrices[(uint)p.identityState.y], float4(WhaleDeform(seed.form.xyz, _Song), 1)).xyz;
        float3 peel = normalize(source - group.impulse.xyz + float3(0.001,0.002,0.003));
        source += peel * sin(saturate(age / 1.65) * 3.14159265) * 9;
        float3 forming = lerp(source, target, morph);
        forming += MatterFlowDelta(source*.25,age,seed.traits.z)*sin(morph*3.14159265)*2.2;
        acceleration += (forming - position) * 120 - (velocity - dolphinVelocity.xyz * morph) * 21.9;
    }
    else if (phase < 0.5)
    {
        float3 offset = target - position;
        if (kind < 0.5)
        {
            acceleration += offset * 0.14 - velocity * 0.78;
            float3 currentOffset = position - _Current.xyz;
            float currentWeight = saturate(1.0 - length(currentOffset) / max(0.01, _Current.w));
            acceleration += _CurrentVelocity * currentWeight * _CurrentEnergy * 0.12;
            acceleration += Curl(position * 0.035, _Song * 0.18 + seed.traits.z * 13.0) * currentWeight * _CurrentEnergy * 0.18;
        }
        else
        {
            float stiffness = kind > 1.5 && kind < 2.5 ? 78.0 : kind > 2.5 ? 100.0 : 54.0;
            float damping = 2.0 * sqrt(stiffness);
            if (kind > 2.5)
                acceleration += offset * stiffness - (velocity - _WhaleVelocity) * damping;
            else
                acceleration += offset * stiffness - velocity * damping;
            acceleration += Curl(position * 0.12, _Song * 0.45 + seed.traits.z * 9.0) * (0.10 + energy * 0.22);
        }
    }
    else if (phase < 1.5)
    {
        if (kind > 1.5 && kind < 2.5)
        {
            float stiffness = 84.0;
            acceleration += (target - position) * stiffness - velocity * (2.0 * sqrt(stiffness));
        }
        else
        {
            float3 outward = position - group.impulse.xyz;
            if (dot(outward, outward) < 0.01) outward = float3(Hash(id.x + 2.0) - 0.5, Hash(id.x + 8.0) - 0.5, Hash(id.x + 17.0) - 0.5);
            float tail = saturate(seed.traits.w);
            float3 steering = mul((float3x3)group.localToWorld, float3(0, 0, 1));
            float3 scatterTarget = target + normalize(outward) * (2.0 + tail * 12.0) + steering * (tail * 5.0);
            acceleration += (scatterTarget - position) * 8.0 - velocity * 3.2;
            acceleration += normalize(outward) * max(0.0, group.impulse.w) * 0.8;
        }
    }
    else if (phase < 2.5)
    {
        float4 death=MatterDeathEnvelope(age,kind>2.5);
        float buildEnd=_MatterDeathTimings.x+(kind>2.5?_MatterDeathTimings.z:_MatterDeathTimings.y);
        float release = smoothstep(0.35, 0.95, age);
        float erupt = death.y*(1.0-smoothstep(buildEnd,buildEnd+2.0,age));
        float settle = smoothstep(buildEnd, max(9.6,buildEnd+4), age);
        float travel = smoothstep(1.2, 3.2, age);
        float3 toDestination = seed.destination.xyz - position;
        float3 axis = normalize(toDestination + float3(0.001, 0.002, 0.003));
        float3 radial = Curl(position * 0.045 + seed.traits.z, _Song * 0.32 + seed.traits.z * 11.0);
        float3 vortex = cross(axis, radial);
        // Neighbouring anatomical bands peel together before the material joins the reef.
        float band = floor(seed.form.z / 12.0);
        float sector = floor(atan2(seed.form.y, seed.form.x) * 3.0);
        float turn = _Song * 0.55 + band * 1.13 + sector * 0.71;
        float3 groupFlow = mul((float3x3)group.localToWorld,
            float3(cos(turn), sin(turn * 0.8) * 0.55, sin(turn))) * 26.0;
        acceleration += (target - position) * 70.0 * (1.0 - release);
        acceleration -= velocity * 16.0 * (1.0 - release);
        acceleration += groupFlow * erupt + radial * (3.0 * erupt) + normalize(vortex + 0.0001) * (2.0 * erupt);
        if (kind > 2.5)
        {
            float whaleStiffness = 12.0;
            acceleration += toDestination * lerp(0.015, whaleStiffness, settle) * travel;
            acceleration -= velocity * lerp(0.8, 2.0 * sqrt(whaleStiffness), settle) * release;
        }
        else
            acceleration += toDestination * lerp(0.015, 12.0, settle) * travel - velocity * lerp(0.8, 5.2, settle) * release;
        acceleration += vortex * (0.7 * (1.0 - settle));
        acceleration += MatterCurrent(position,age,seed.traits.z)*10.0*erupt*_MatterDeathStyle.x;
        float3 origin = group.impulse.xyz;
        float3 burst = position - origin;
        acceleration += normalize(burst + 0.0001) * max(0.0, group.impulse.w) * erupt;
    }
    else
    {
        float3 destination = seed.destination.xyz;
        float3 offset = destination - position;
        acceleration += offset * 10.0 - velocity * 5.8;
        float3 currentOffset = position - _Current.xyz;
        float currentWeight = saturate(1.0 - length(currentOffset) / max(0.01, _Current.w));
        acceleration += _CurrentVelocity * currentWeight * (0.35 + _CurrentEnergy * 0.12);
        acceleration += Curl(position * 0.035, _Song * 0.18 + seed.traits.z * 13.0) * currentWeight * _CurrentEnergy * 0.12;
    }

    float playerDistance = length(position - _Player);
    float playerWake = saturate(1.0 - playerDistance / 22.0);
    if (kind < 0.5)
    {
        float remembered = p.identityState.w;
        float3 wake = normalize(position - _Player + float3(0.001, 0.002, 0.003));
        float currentWake = saturate(1.0 - length(position - _Current.xyz) / max(0.01, _Current.w)) * saturate(_CurrentEnergy);
        acceleration += wake * playerWake * (1.6 + length(_PlayerVelocity) * 0.28) - velocity * playerWake * 0.42;
        float3 currentRadial = normalize(position - _Current.xyz + float3(0.001, 0.002, 0.003));
        acceleration += currentRadial * currentWake * (1.4 + length(_CurrentVelocity) * 0.2);
        acceleration += _CurrentVelocity * currentWake * 0.14;
        remembered = saturate(max(remembered * exp(-_Delta * 0.22), max(playerWake * 0.9, currentWake * 0.95)));
        p.identityState.w = remembered;
    }

    float step = min(_Delta, 1.0 / 60.0);
    velocity += acceleration * step;
    velocity *= exp(-step * (phase > 1.5 ? 0.65 : 1.0));
    float maxSpeed = phase > 4.5 ? 360 : phase > 3.5 ? 130 : phase > 1.5 && phase < 2.5 ? (kind > 2.5 ? 112.0 : 46.0) : kind > 2.5 && phase < 0.5 ? 200.0 : 24.0;
    velocity = clamp(length(velocity), 0.0, maxSpeed) * normalize(velocity + 0.000001);
    position += velocity * step;

    float impact = saturate(energy * exp(-max(0.0, age) * (phase > 1.5 ? 0.8 : 2.5)));
    if (isWhale && phase < 0.5)
        p.identityState.w = WhalePatchHeat(position, seed.form.z);
    p.positionAge = float4(position, p.positionAge.w + step);
    p.velocityEnergy = float4(velocity, impact);
    if (phase > 4.5)
    {
        float ribbon = pow(0.5 + 0.5 * sin(age * 5.0 - seed.form.z * 0.16 + seed.traits.z * 8.0), 6.0);
        float gathering=1.0+.3*sin(saturate(age/3.0)*3.14159265);
        p.colorSize = float4(lerp(float3(0.025,0.36,1.6),float3(0.06,1.5,2.4),ribbon)*gathering, seed.form.w * 1.3);
        p.identityState.w = 0;
    }
    else if (phase > 3.5)
    {
        float glint = pow(0.5 + 0.5 * sin(_Song * 2.0 - _AlternateForms[id.x].z * 0.55), 10);
        float3 ocean = lerp(float3(0.035,0.30,1.5),float3(0.03,1.35,2.0),glint);
        float peeling=1.0+.3*sin(saturate(age/1.65)*3.14159265);
        p.colorSize = float4(ocean * (0.5 + glint * 0.8)*peeling, _AlternateForms[id.x].w);
        p.identityState.w = 0;
    }
    else if (kind > 2.5 && phase < 0.5)
    {
        float angle = atan2(seed.form.y, seed.form.x);
        float ribPhase = angle * 9.0 + seed.form.z * 0.13 + sin(seed.form.z * 0.045 + angle * 2.1) * 0.7;
        float rib = pow(saturate(0.5 + 0.5 * cos(ribPhase)), 14.0);
        float wave = 0.5 + 0.5 * sin(_Song * 0.42 - seed.form.z * 0.055 + seed.form.x * 0.025);
        float dive = saturate(-_WhaleVelocity.y / 16.0);
        float tailZone = 1.0 - smoothstep(-76.0, -36.0, seed.form.z);
        float tailBeat = abs(sin(_Song * 0.78 + seed.form.z * 0.047));
        float3 cobalt = float3(0.035, 0.16, 0.80);
        float3 sapphire = float3(0.025, 0.48, 1.55);
        float3 cyan = float3(0.025, 1.35, 1.60);
        float3 violet = float3(0.68, 0.10, 1.45);
        float3 magenta = float3(1.75, 0.08, 0.62);
        float3 pearlGold = float3(2.25, 1.10, 0.20);
        float3 pearl = float3(1.45, 1.85, 2.15);
        float3 ocean = lerp(sapphire, cyan, wave * 0.86);
        float3 bankColor = lerp(violet, magenta, wave);
        float bankMix = smoothstep(0.15, 0.85, _WhaleTurn * 0.70 + dive * 0.65) * (0.70 + wave * 0.30) * (1 - _WhaleArrival);
        float3 movingColor = lerp(lerp(cobalt, ocean, 0.84), bankColor, bankMix);
        float surfaceMix = smoothstep(0.15, 0.90, _WhaleSurfaceActivity) * (0.70 + wave * 0.30) * (1 - _WhaleArrival);
        float anatomy = 0.5 + 0.5 * sin(angle);
        movingColor = lerp(movingColor, pearlGold, surfaceMix * (0.72 + anatomy * 0.28));
        movingColor = lerp(movingColor, cyan, (1.0 - anatomy) * (1.0 - surfaceMix) * 0.28);
        movingColor = lerp(movingColor, pearl, tailZone * tailBeat * 0.2);
        movingColor += rib * float3(0.025, 0.07, 0.1);
        float scaleCell = floor(angle * 12.0) * 13.0 + floor(seed.form.z * 0.42);
        float mottling = 0.78 + Hash(scaleCell) * 0.22;
        p.colorSize.rgb = movingColor * (0.40 + sqrt(rib) * 0.40) * mottling;
        if (seed.traits.w > 1.5) {
            float traveling = pow(0.5 + 0.5 * sin(seed.form.z * 0.07 - _Song * 1.15 + seed.traits.z * 5.0), 7.0);
            p.colorSize.rgb = lerp(movingColor, pearl, 0.12 + traveling * 0.36) * (0.45 + traveling * 1.20);
            if (seed.traits.w > 3.5) p.colorSize.rgb = pearl * 3.0;
        }
    }
    else if (kind > 0.5 && phase > 1.5 && phase < 2.5)
    {
        float4 death=MatterDeathEnvelope(age,kind>2.5);
        float flash = death.z;
        float cloud = smoothstep(0.4, 2.0, age) * (1.0 - smoothstep(2.2, 5.5, age));
        float3 cloudColor = Hash(floor(seed.form.z * 0.3) + floor(seed.traits.z * 8.0)) > 0.6
            ? float3(0.24,1.50,0.65) : float3(0.08,0.80,1.55);
        float3 transitionColor = lerp(cloudColor * (0.45 + cloud * 0.55), float3(0.035,0.85,2.8), flash);
        p.colorSize.rgb = lerp(p.colorSize.rgb, transitionColor*(1+flash*_MatterDeathStyle.y), 1.0 - exp(-step * 4.0));
        p.colorSize.w = seed.form.w * (1.0 + cloud * 1.8);
    }
    else if (phase > 2.5)
        p.colorSize = float4(lerp(seed.color.rgb, float3(0.12,0.70,0.48), 0.72), seed.form.w * 1.3);
    p.identityState.z = phase;
    _Particles[id.x] = p;
}
