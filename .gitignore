# Keep the verified Windows distribution, not temporary capture builds.
/Builds/*
!/Builds/Windows/
/Builds/Windows/*_BackUpThisFolder_ButDontShipItWithYourGame/
/Builds/Windows/*_BurstDebugInformation_DoNotShip/
/Builds/Windows/*.log
/Verification/

# Preserve local recording assets without publishing raw or failed takes.
/Video/*
!/Video/PV/
/Video/PV/LIMINAL_raw.mp4
/Video/PV/*.log
/Tools/TrailerRecorder.exe
